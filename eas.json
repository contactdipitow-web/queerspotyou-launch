{
  "cli": { "version": ">= 16.0.1", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development", "env": { "EAS_NO_FROZEN_LOCKFILE": "1" } },
    "preview": { "distribution": "internal", "environment": "preview", "env": { "EAS_NO_FROZEN_LOCKFILE": "1" } },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "ios": { "image": "latest", "resourceClass": "m-medium" },
      "android": { "image": "latest", "buildType": "app-bundle" },
      "env": { "EAS_NO_FROZEN_LOCKFILE": "1" }
    }
  }
}
