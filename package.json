{
  "name": "queerspotyou-launch",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "preflight:ios": "expo config --type public && tsc --noEmit && expo export --platform ios && expo prebuild --platform ios --clean --no-install"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "expo": "~57.0.18",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
